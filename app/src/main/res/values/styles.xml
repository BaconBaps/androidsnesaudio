<resources>
    <style name="AppBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/pixelify_sans</item>
        <item name="android:colorAccent">#7453CC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F6F3EB</item>
        <item name="android:navigationBarColor">#302B40</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme" parent="AppBase"/>
    <style name="AppDarkDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/pixelify_sans</item>
    </style>
    <style name="AppLightDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">@font/pixelify_sans</item>
    </style>
</resources>
