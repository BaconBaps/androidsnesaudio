<!-- RemoteViews is hosted by the launcher, with no Activity window background. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="Overdraw" android:id="@+id/widget_root" android:background="#101017" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <ImageView android:id="@+id/widget_chrome" android:src="@drawable/widget_chrome" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:baselineAligned="false">
            <TextView android:id="@+id/widget_heading" android:textColor="#C7E799" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:includeFontPadding="false" android:fontFamily="monospace" android:textStyle="bold" android:textSize="11sp" android:text="@string/widget_now_playing"/>
            <ImageView android:id="@+id/widget_band" android:src="@drawable/skin_rail" android:scaleType="fitXY" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginStart="10dp" android:importantForAccessibility="no"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_title" android:text="@string/widget_empty" android:textColor="#EDF2F4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textSize="18sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_artist" android:text="@string/app_name" android:textColor="#BBC3CB" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:textSize="11sp" android:singleLine="true" android:ellipsize="end"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:baselineAligned="false">
            <Chronometer android:id="@+id/widget_time" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:textSize="11sp" android:fontFamily="monospace"/>
            <TextView android:id="@+id/widget_duration" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:textSize="11sp" android:fontFamily="monospace"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:baselineAligned="false">
            <ImageButton android:id="@+id/widget_previous" android:layout_width="56dp" android:layout_height="48dp" android:background="@drawable/widget_key" android:padding="12dp" android:scaleType="center" android:src="@android:drawable/ic_media_previous" android:contentDescription="@string/widget_previous"/>
            <ImageButton android:id="@+id/widget_play" android:layout_width="64dp" android:layout_height="48dp" android:layout_marginHorizontal="8dp" android:background="@drawable/widget_key" android:padding="12dp" android:scaleType="center" android:src="@android:drawable/ic_media_play" android:contentDescription="@string/widget_play"/>
            <ImageButton android:id="@+id/widget_next" android:layout_width="56dp" android:layout_height="48dp" android:background="@drawable/widget_key" android:padding="12dp" android:scaleType="center" android:src="@android:drawable/ic_media_next" android:contentDescription="@string/widget_next"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
